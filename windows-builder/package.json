{
  "name": "saffron-pos",
  "productName": "Saffron POS",
  "version": "1.0.0",
  "description": "Point of Sale & Business Management for sanitary/plumbing/building-material stores",
  "author": {
    "name": "Saffron POS"
  },
  "license": "UNLICENSED",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:win:portable": "electron-builder --win portable",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.bukhari.pos",
    "productName": "Saffron POS",
    "copyright": "Copyright © 2026 Saffron POS",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "electron/**/*",
      "!electron/.gitkeep"
    ],
    "extraResources": [
      {
        "from": "resources/php",
        "to": "php",
        "filter": ["**/*"]
      },
      {
        "from": "resources/mariadb",
        "to": "mariadb",
        "filter": ["**/*"]
      },
      {
        "from": "resources/application",
        "to": "application",
        "filter": ["**/*"]
      },
      {
        "from": "resources/icons",
        "to": "icons",
        "filter": ["**/*"]
      },
      {
        "from": "resources/fonts",
        "to": "fonts",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "resources/icons/icon.ico",
      "artifactName": "Saffron POS Setup ${version} ${arch}.exe",
      "publisherName": "Saffron POS",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Saffron POS",
      "runAfterFinish": true,
      "installerIcon": "resources/icons/icon.ico",
      "uninstallerIcon": "resources/icons/icon.ico",
      "installerHeaderIcon": "resources/icons/icon.ico",
      "deleteAppDataOnUninstall": false,
      "perMachine": false,
      "include": "scripts/installer.nsh",
      "installerLanguages": ["English"],
      "language": "2057",
      "welcomeTitle": "Saffron POS Setup",
      "welcomeText": "Welcome to Saffron POS.\n\nThis wizard will guide you through the installation of Saffron POS on your computer.\n\nSaffron POS is a complete Point of Sale and Business Management system for sanitary, plumbing, and building material stores.",
      "finishTitle": "Installation Complete",
      "finishText": "Saffron POS has been installed successfully.\n\nClick Finish to launch Saffron POS.",
      "uninstallTitle": "Uninstall Saffron POS",
      "uninstallText": "Saffron POS will be removed from your computer.\n\nYour business data, backups, and database will be kept safe in:\n%LOCALAPPDATA%\\BukhariPOS\\\n\nTo also delete all data, check the box below."
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
