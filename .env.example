# ============================================================
# Saffron POS — Environment Variables
# Copy this file to .env and fill in the values for local dev.
# On Vercel: set these in Project Settings → Environment Variables.
# ============================================================

# ── Database ──
# For Vercel: use PlanetScale, Neon, or any MySQL-compatible serverless DB.
# For local: use your local MariaDB/MySQL credentials.
POS_DB_HOST=localhost
POS_DB_PORT=3306
POS_DB_USER=saffron_app
POS_DB_PASS=CHANGE_THIS_PASSWORD
POS_DB_NAME=pos_db

# ── Base URL ──
# If app is at https://your-domain.com/pos → set to /pos
# If app is at root https://your-domain.com/ → set to /
POS_BASE_URL=/pos

# ── Vercel Serverless ──
# Set to "1" to force DB-backed sessions (required on Vercel).
POS_DB_SESSIONS=1
