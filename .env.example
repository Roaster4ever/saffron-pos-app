# ============================================================
# Saffron POS — Environment Variables
# Copy to .env for local dev. On Vercel: set in Project Settings.
# ============================================================

# ── Neon/Vercel Postgres (preferred) ──
# Vercel auto-injects POSTGRES_URL when you install Neon from Marketplace.
# For local dev, paste the Neon pooled connection string here.
POSTGRES_URL=

# ── MySQL/MariaDB (local dev fallback) ──
# Only used if POSTGRES_URL is not set.
POS_DB_HOST=localhost
POS_DB_PORT=3306
POS_DB_USER=saffron_app
POS_DB_PASS=
POS_DB_NAME=pos_db

# ── Base URL ──
# Vercel: leave unset (defaults to empty — app at root)
# Local: /pos (app at http://localhost:8000/pos/)
POS_BASE_URL=

# ── Vercel ──
POS_DB_SESSIONS=1
