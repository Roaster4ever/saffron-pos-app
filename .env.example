# ============================================================
# Saffron POS — Environment Variables
# Copy to .env for local dev. On Vercel: set in Project Settings.
# ============================================================

# ── Database (required) ──
POS_DB_HOST=localhost
POS_DB_PORT=3306
POS_DB_USER=saffron_app
POS_DB_PASS=CHANGE_THIS_PASSWORD
POS_DB_NAME=pos_db

# ── Base URL ──
# Vercel: leave unset (defaults to empty — app at root)
# Local: /pos (app at http://localhost:8000/pos/)
POS_BASE_URL=/pos

# ── Vercel ──
# Set to 1 to force DB-backed sessions (auto-detected on Vercel)
POS_DB_SESSIONS=1
