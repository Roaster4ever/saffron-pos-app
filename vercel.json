{
  "builds": [
    { "src": "*.php", "use": "@vercel/php" },
    { "src": "includes/*.php", "use": "@vercel/php" },
    { "src": "pages/*.php", "use": "@vercel/php" }
  ],
  "routes": [
    { "src": "/pos/(.*)", "dest": "/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
